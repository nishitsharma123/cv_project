# ─── FinPilot / Handwritten Indic-Script Form Digitiser ─────────────────────
# Frontend environment variables
# Copy this file to .env.local and adjust as needed.
#
#   cp .env.example .env.local     # macOS / Linux
#   Copy-Item .env.example .env.local   # Windows PowerShell
#
# Variables prefixed with VITE_ are embedded at build time by Vite.
# Never put secrets here.
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the running backend API (no trailing slash).
# Matches the default uvicorn host / port used during development.
VITE_API_URL=http://127.0.0.1:8000
