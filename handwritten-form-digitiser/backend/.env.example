# ==============================================================================
# Environment Configuration Template: Handwritten Indic-Script Form Digitiser
# ==============================================================================
# Copy this file to .env for local configuration:
#   Copy-Item .env.example .env (PowerShell)
#   cp .env.example .env        (Bash)
# ==============================================================================

# Application Metadata
PROJECT_NAME="Handwritten Indic-Script Form Digitiser"
VERSION="0.1.0"
API_V1_STR="/api/v1"

# Environment Profile: development | staging | production | testing
ENVIRONMENT="development"
DEBUG=true

# API Documentation Paths (automatically suppressed in production)
DOCS_URL="/docs"
OPENAPI_URL="/openapi.json"
REDOC_URL="/redoc"

# CORS Configuration
# Comma-separated list of allowed frontend origins or JSON array format
ALLOWED_ORIGINS='["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173", "http://127.0.0.1:3000"]'

# Logging Settings
# Level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL="INFO"
# Format: text | json
LOG_FORMAT="text"

# File Upload Limits
MAX_UPLOAD_SIZE_MB=15
